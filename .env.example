# Environment Variables Template
# Never commit actual credentials to version control!
# Replace placeholders with actual values for each environment

# SERVER CONFIG
PORT=4000
NODE_ENV=production

# Database
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/NotionStudydb

# JWT & Security
SECRETE_KEY=your_super_secret_jwt_key_min_32_characters

# Cloudinary (File Upload)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
FOLDER_NAME=StudyNotion

# Razorpay (Payments)
YOUR_KEY_ID=your_razorpay_key_id
YOUR_KEY_SECRET=your_razorpay_key_secret

# Email Service
Usermail=your_email@gmail.com
Userpass=your_app_specific_password

# Frontend URL (CORS)
CLIENT_URL=https://yourdomain.com

# Temp Directory (optional, uses system temp by default)
TEMP_DIR=/tmp

# Database Connection Options (optional)
MONGODB_USE_NEWURL_PARSER=true
MONGODB_USE_UNIFIED_TOPOLOGY=true
